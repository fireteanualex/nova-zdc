# NOVA - ZDC 2026 - parametrii FC pe care ii cere companion-ul (Pi)
#
# Placa: CubePilot Cube Orange+, ArduCopter 4.6.2 (de la 08.10.2026).
# Fisierul anterior (CUAV X7+, ArduCopter 4.7.1, 37 de parametri) e la
# commit-ul f228786 - vezi docs/FC_REFERINTE.txt.
#
# MINIMAL, decizia echipei (08.10.2026): doar ce trebuie ca FC-ul sa poata
# urma instructiunile Pi-ului - pozitia din camera (VISION_POSITION_ESTIMATE)
# ca sursa EKF3 si setul de surse 2 fara GNSS, comutat de Pi in segment.
# Tot restul il seteaza echipa de mana in ArduPilot: cadru, viteze si
# acceleratii (WPNAV_*, LAND_SPEED), failsafe-uri, safety switch (BRD_SAFETY*),
# porturile seriale (SERIALx_*, BRD_SERx_RTSCTS), verificarile de armare
# (ARMING_CHECK), FLTMODE_CH. tools/check_params.py ignora oricum seriale si
# armare (HAND_SET), chiar daca ar aparea aici.
#
# Scriere + citire inapoi, apoi REBOOT (VISO_TYPE se aplica doar la boot):
#   python3 tools/check_params.py --conn /dev/serial0 --baud <baud> \
#       --parm config/nova_flight.parm --write --reboot
#
# Nume verificate in tag-ul Copter-4.6.2 (identice pe 4.7.1):
#   libraries/AP_VisualOdom/AP_VisualOdom.cpp:37, :83, :99
#   libraries/AP_NavEKF/AP_NavEKF_Source.cpp:62-100, :140

# Camera ca sursa de pozitie: MAVLink VISION_POSITION_ESTIMATE (cere REBOOT).
VISO_TYPE,1
# Varsta estimarii la sosire (~100 ms de la captura); implicit 10 ms.
VISO_DELAY_MS,100
VISO_POS_M_NSE,0.5

# Setul EKF3 2, activat de Pi in segmentul autonom (regula 15.2.5: fara GNSS):
# pozitie orizontala din camera, inaltime din barometru, cap din busola.
EK3_SRC2_POSXY,6
EK3_SRC2_VELXY,0
EK3_SRC2_POSZ,1
EK3_SRC2_VELZ,0
EK3_SRC2_YAW,1
# Bit 0 (FuseAllVelocities) STINS: pe 4.6.2 implicitul e 1
# (AP_NavEKF_Source.cpp:140) si ar fuziona viteza GPS din setul 1 si pe
# setul 2. Cu el aprins, nova/ekf_source.py refuza comutarea.
EK3_SRC_OPTIONS,0
