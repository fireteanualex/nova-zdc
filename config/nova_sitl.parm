# NOVA - ZDC 2026 - configuratie SITL
# Incarcat la pornire cu sim_vehicle.py --add-param-file=
# Fiind aplicat inainte de initializare, sub-parametrii PLND_* si RNGFND1_*
# exista de la boot, deci nu mai e nevoie de ciclul set -> reboot -> set.

# --- Frame: Quad in X (ca NOVA) ---
FRAME_CLASS,1
FRAME_TYPE,1

# --- Telemetru: MAVLink de la companion computer (camera face solvePnP) ---
RNGFND1_TYPE,10
RNGFND1_ORIENT,25
RNGFND1_MIN,0.05
RNGFND1_MAX,30
RNGFND1_GNDCLR,0.0745

# Urmarirea de suprafata dezactivata: telemetrul nostru e intermitent prin
# constructie (dispare cand markerul iese din cadru) si declanseaza
# "Failsafe: Terrain Rangefinder Unhealthy".
SURFTRAK_MODE,0
TERRAIN_ENABLE,0

# --- Precision landing ---
PLND_ENABLED,1
PLND_TYPE,1
PLND_EST_TYPE,1
PLND_STRICT,2
PLND_ALT_MIN,0.35
PLND_YAW_ALIGN,0

# --- Verificari de armare ---
# Bit 15 = Rangefinder. Camera nu poate produce range la sol (markerul nu
# incape in cadru la 74 mm), deci verificarea e imposibil de trecut.
# Compensat prin PLND_STRICT=2 si monitorizare in Safety Supervisor.
ARMING_SKIPCHK,32768
